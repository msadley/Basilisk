{
  "name": "basilisk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "build": "tsc -b",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm --filter web lint",
    "vite": "pnpm --filter web dev",
    "relay": "pnpm build && node apps/relay/dist/index.js",
    "dev": "pnpm --parallel build",
    "clean": "rm -rf apps/*/dist packages/*/dist apps/*/node_modules/.tmp packages/*/node_modules/.tmp *.tsbuildinfo apps/*/*.tsbuildinfo packages/*/*.tsbuildinfo"
  },
  "author": "Adley Silva Mendes",
  "license": "ISC",
  "description": "A chat app built on top of libp2p, using TypeScript.",
  "overrides": {
    "@multiformats/multiaddr": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "prettier": "^3.9.4",
    "typescript": "^5.9.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  }
}
