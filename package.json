{
  "name": "basilisk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "build": "tsc -b",
    "vite": "pnpm --filter web dev",
    "relay": "pnpm build && node apps/relay/dist/index.js",
    "dev": "pnpm --parallel build",
    "clean": "rm -rf **/dist **/node_modules/.tmp"
  },
  "author": "Adley Silva Mendes",
  "license": "ISC",
  "description": "A chat app built on top of libp2p, using TypeScript.",
  "overrides": {
    "@multiformats/multiaddr": "^13.0.3"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "concurrently": "^10.0.3",
    "cross-env": "^10.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.4",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.x",
      "onFail": "download"
    }
  }
}
